# ---- Server & Mode ----
PORT=4000
NODE_ENV=development
# DRY_RUN=true => paper trading only, zero capital, no on-chain transaction is ever signed.
DRY_RUN=true
TZ=Asia/Jakarta

# ---- AI Provider (DeepSeek, OpenAI-compatible) ----
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_CHAT=deepseek-chat
DEEPSEEK_MODEL_REASONER=deepseek-reasoner

# ---- Solana & Meteora ----
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_key
METEORA_API_URL=https://dlmm.datapi.meteora.ag
# Only used when DRY_RUN=false (live mode is not implemented yet). Leave blank.
SOLANA_PRIVATE_KEY=

# ---- Telegram Dispatcher ----
# Leave both blank to silently disable Telegram notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Paper Trading Engine ----
VIRTUAL_SOL_PER_POSITION=1.0
MAX_CONCURRENT_POSITIONS=3
TAKE_PROFIT_PCT=5.0
STOP_LOSS_PCT=-8.0
MAX_POSITION_AGE_HOURS=24

# ---- Screener Thresholds ----
MIN_24H_VOLUME_USD=10000
MIN_FEE_TVL_RATIO=0.008
MIN_TVL_USD=50000
# Outlier guard: reject pools reporting an implausible 24h fee/TVL ratio
# (0.25 = 25%/24h). Set to 999 to disable.
MAX_FEE_TVL_RATIO=0.25

# ---- Anti-Rug Screen ----
ANTIRUG_ENABLED=true
ANTIRUG_MAX_TOP10_HOLDER_PCT=25
ANTIRUG_REQUIRE_MINT_REVOKED=true
ANTIRUG_REQUIRE_FREEZE_REVOKED=true
# What an unverifiable check means: reject (fail closed, default) | allow (fail open).
# NOTE: the public Solana RPC blocks getTokenLargestAccounts (HTTP 429), so with the
# default endpoint every candidate resolves to UNKNOWN and is rejected. Use a paid RPC
# (Helius/Triton/QuickNode) or set this to "allow" to trade unscreened pools.
ANTIRUG_ON_ERROR=reject

# ---- Failure-Avoidance Guardrails (validated out-of-sample) ----
# Four hard gates. Together they cut the rate of losses worse than -10% from 6.5%
# to 1.5% in-sample and 8.3% to 0.9% out-of-sample on ~13k enumerated entries.
# These are EXCLUSIONS, not a score: the composite score did not replicate, so
# ranking is left to the plain fee/TVL x volume rule.
MIN_POOL_AGE_HOURS=48
MAX_PRICE_SURGE_1H_PCT=10
MAX_REALIZED_VOL_PCT_PER_HOUR=20
MAX_TVL_USD=500000

# ---- Priority Fee Estimation ----
PRIORITY_FEE_PERCENTILE=75
PRIORITY_FEE_COMPUTE_UNITS=200000

# ---- Post-Trade Reflection ----
POST_MORTEM_ENABLED=true

# ---- Friction / gas optimisation ----
# Floor on the bin range the LLM may choose. A tight range exits sooner and every exit
# burns gas + forced-exit slippage; the unbiased backtest showed friction ($74.80)
# exceeding all fee income ($55.25), so the range is widened by default.
MIN_DOWNSIDE_COVER_PCT=45
MIN_UPSIDE_COVER_PCT=15
FORCED_EXIT_SLIPPAGE_PCT=2.0
# A pool must earn at least this multiple of its round-trip cost in 24h of fees, or
# the entry is skipped.
MIN_FEE_COST_COVERAGE=2.5
# Volatility gate: reject tokens that pumped more than this in 24h.
# Unknown 24h change is rejected too (reject | allow).
MAX_PRICE_CHANGE_24H_PCT=150
VOLATILITY_ON_UNKNOWN=reject

# ---- Anti-churn: pool cooldown & failure lockout ----
# The screener has no memory of its own trades, so a pool that keeps ranking first keeps
# getting re-entered minutes after it was closed out of range — paying gas and forced-exit
# slippage every lap. These two gates give it that memory. Both run before the anti-rug
# screen; set either to 0 to disable it.
#
# Cooldown: exclude a pool for this many hours after ANY of its positions closes.
POOL_COOLDOWN_HOURS=4
# Lockout: consecutive CLOSED_LOSS / CLOSED_OUT_OF_RANGE closes that trip the breaker.
# The run is counted newest-first and reset by any other outcome (a win, a timeout).
POOL_LOCKOUT_CONSECUTIVE_FAILURES=2
# How long a tripped pool stays locked out, measured from its last failure.
POOL_LOCKOUT_HOURS=24

# ---- Optional: TradFi macro via FRED (free key) ----
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ---- Database ----
DATABASE_PATH=./data/flowmetrix.db
